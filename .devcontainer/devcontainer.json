{
  "name": "EduRAG Container",

  "build": {
    // 1. 指向当前文件夹下的 Dockerfile
    "dockerfile": "Dockerfile",
    
    // 2. 【核心】设置构建上下文为上一级目录（项目根目录）
    // 这样 Dockerfile 里的 "COPY requirements.txt ." 才能找到文件
    "context": ".."
  },

  // 3. 把 Streamlit 的端口映射出来
  "forwardPorts": [8501],

  // 4. 挂载根目录的 .env 文件
  "runArgs": [
    "--env-file", ".env"
  ],
  
  // 5. 自动安装插件
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}